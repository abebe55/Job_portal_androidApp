SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=False

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority
MONGO_DB_NAME=jobportal

# Chapa payment gateway
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key

# Production URLs
BACKEND_URL=https://job-portal-androidapp.onrender.com
FRONTEND_URL=https://<your-vercel-app>.vercel.app

# Email — Brevo (https://app.brevo.com → SMTP & API → API Keys)
# Install: pip install brevo-python
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=JobPortal
BREVO_SENDER_EMAIL=noreply@yourdomain.com
